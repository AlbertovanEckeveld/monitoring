    {
      "type": "timeseries",
      "title": "CPU-gebruik (gemiddeld per systeem)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Inclusief loadgen: als die richting 100% gaat, meet je de client in plaats van de storage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "system:node_cpu_utilisation:avg",
          "legendFormat": "{{system}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ceph"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E5484D"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seaweedfs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E63DD"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "loadgen"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8B8D98"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
