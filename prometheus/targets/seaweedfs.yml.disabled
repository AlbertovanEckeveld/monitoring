# Fase 2 (SeaweedFS). Wordt door scripts/set-phase.sh aan/uit gezet (.disabled).
# Elk component gestart met -metricsPort:
#   weed master -metricsPort=9324 ...
#   weed volume -metricsPort=9325 ...
#   weed filer  -metricsPort=9326 ...
#   weed s3     -metricsPort=9327 ...
# Aangenomen topologie: 3 masters (01-03), volume op alle 4, filer + s3 op 01.
# Pas dit aan als jullie het anders uitrollen.
# 'cluster' is nodig voor het officiële SeaweedFS-dashboard (variabele $cluster).

- targets: ['172.31.46.179:9324']
  labels: {system: seaweedfs, cluster: sue-poc, component: master, instance: sue-poc-storage01}
- targets: ['172.31.33.90:9324']
  labels: {system: seaweedfs, cluster: sue-poc, component: master, instance: sue-poc-storage02}
- targets: ['172.31.33.88:9324']
  labels: {system: seaweedfs, cluster: sue-poc, component: master, instance: sue-poc-storage03}

- targets: ['172.31.46.179:9325']
  labels: {system: seaweedfs, cluster: sue-poc, component: volume, instance: sue-poc-storage01}
- targets: ['172.31.33.90:9325']
  labels: {system: seaweedfs, cluster: sue-poc, component: volume, instance: sue-poc-storage02}
- targets: ['172.31.33.88:9325']
  labels: {system: seaweedfs, cluster: sue-poc, component: volume, instance: sue-poc-storage03}
- targets: ['172.31.32.222:9325']
  labels: {system: seaweedfs, cluster: sue-poc, component: volume, instance: sue-poc-storage04}

- targets: ['172.31.46.179:9326']
  labels: {system: seaweedfs, cluster: sue-poc, component: filer, instance: sue-poc-storage01}

- targets: ['172.31.46.179:9327']
  labels: {system: seaweedfs, cluster: sue-poc, component: s3, instance: sue-poc-storage01}
